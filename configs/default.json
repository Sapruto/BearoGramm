{
    "APP": {
        "APP_NAME": "My App",
        "APP_VERSION": "1.0.0",
        "DEBUG": false,
        "LOG_LEVEL": "INFO"
    },
    "CORS": {
        "ALLOWED_ORIGINS": ["http://localhost:5000", "http://localhost:8000"],
        "ALLOWED_METHODS": ["*"],
        "ALLOWED_HEADERS": ["*"],
        "ALLOW_CREDENTIALS": true
    },
    "RATE_LIMIT": {
        "ENABLED": true,
        "REQUESTS_PER_MINUTE": 60,
        "BURST": 10
    },
    "REDIS": {
        "REDIS_HOST": "localhost",
        "REDIS_PORT": 6379,
        "REDIS_DB": 0
    },
    "DATABASE": {
        "SQL_ECHO": false,
        "DB_POOL_SIZE": 10,
        "DB_MAX_OVERFLOW": 20,
        "DB_POOL_TIMEOUT": 30,
        "POOL_RECYCLE": 3600,
        "INIT_DB": true
    },
    "MEDIA_STORAGE": {
        "UPLOAD_DIR": "uploads",
        "BOTO_3": {
            "USE_S3": false,
            "S3_ENDPOINT": "https://s3.ru1.storage.beget.cloud",
            "S3_BUCKET_NAME": "your-bucket",
            "S3_REGION": "ru1"
        }
    },
    "CLIENT_SMS_TYPE": "test"
}